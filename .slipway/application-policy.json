{
  "schema": "proof.liskov.application-manifest",
  "schemaVersion": 4,
  "applicationId": "proof-docs",
  "metadata": {
    "appType": "managed-web-app",
    "labels": [
      "proof",
      "docs",
      "liskov-canary"
    ],
    "description": "PROOF public documentation served as a Liskov canary workload."
  },
  "release": {
    "mode": "build",
    "artifact": {
      "kind": "ipfs_bundle",
      "encryption": {
        "mode": "none"
      }
    },
    "builder": {
      "kind": "github",
      "repository": "proof-computer/docs",
      "allowedRefs": [
        "refs/heads/main"
      ],
      "workflowRef": "proof-computer/docs/.github/workflows/slipway-artifact.yml@refs/heads/main",
      "manifestPath": ".slipway/application-policy.json"
    }
  },
  "runtime": {
    "engine": "nodejs",
    "command": "node proof-docs-acurast.mjs",
    "role": "docs-web",
    "resources": {
      "memoryMiB": 256,
      "storageMiB": 128,
      "networkRequestQuota": 700
    },
    "requiredModules": [
      "network"
    ]
  },
  "deployment": {
    "parallelism": 1,
    "schedule": {
      "durationMs": 3600000,
      "maxStartDelayMs": 600000
    },
    "placement": {
      "processorSelection": {
        "mode": "open_market",
        "allowUnknownManager": false,
        "requireScheduleClear": true,
        "requireConsumerAccess": true,
        "maxHeartbeatAgeSeconds": 300,
        "candidateLimit": 16,
        "scanLimit": 64
      }
    },
    "lifecycle": {
      "renewal": {
        "mode": "before_scheduled_end",
        "leadTime": {
          "mode": "fixed",
          "durationMs": 600000
        }
      },
      "update": {
        "timing": "immediate",
        "existingJobs": {
          "mode": "run_until_scheduled_end"
        }
      },
      "recovery": {
        "launch": {
          "maxRetries": 5
        },
        "runtimeFailure": {
          "mode": "wait_until_scheduled_end"
        }
      }
    },
    "spend": {
      "maxRewardPlanckPerJob": "50000000000",
      "maxNativeFeePlanckPerJob": "10000000000"
    }
  },
  "ingress": {
    "http": {
      "mode": "required",
      "port": 3000,
      "healthPath": "/health"
    }
  },
  "observability": {
    "logs": {
      "enabled": false
    },
    "runtimeDiagnostics": {
      "signed": true
    }
  },
  "configuration": {
    "variables": [],
    "secrets": []
  }
}
