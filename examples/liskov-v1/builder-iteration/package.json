{
  "name": "builder-iteration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/bundle.js && node scripts/smoke-bundle.mjs"
  },
  "dependencies": {
    "@proof-computer/liskov-runtime": "github:proof-computer/liskov-runtime-js#v0.3.33"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@proof-computer/liskov-runtime",
      "esbuild"
    ]
  }
}
