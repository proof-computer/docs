{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "runtime-entrypoint.mts",
    "encrypted-module.mts",
    "retained-v5-starter/src/**/*.ts",
    "retained-v5-starter/test/**/*.ts"
  ]
}
