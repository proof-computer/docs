{
  "schema": "proof.liskov.application-manifest",
  "schemaVersion": 4,
  "applicationId": "queue-worker",
  "metadata": {
    "appType": "background-worker",
    "labels": [
      "worker"
    ],
    "description": "A single scheduled worker with no ingress or secrets."
  },
  "runtime": {
    "engine": "nodejs",
    "command": "node worker.js",
    "role": "worker",
    "resources": {
      "memoryMiB": 256,
      "storageMiB": 64,
      "networkRequestQuota": 100
    },
    "requiredModules": [
      "network"
    ]
  },
  "deployment": {
    "parallelism": 1,
    "schedule": {
      "durationMs": 1800000,
      "maxStartDelayMs": 300000
    },
    "lifecycle": {
      "renewal": {
        "mode": "after_scheduled_end"
      },
      "update": {
        "timing": "next_scheduled_renewal",
        "existingJobs": {
          "mode": "run_until_scheduled_end"
        }
      },
      "recovery": {
        "launch": {
          "maxRetries": 3
        },
        "runtimeFailure": {
          "mode": "wait_until_scheduled_end"
        }
      }
    }
  },
  "release": {
    "mode": "build",
    "artifact": {
      "kind": "ipfs_bundle",
      "encryption": {
        "mode": "none"
      }
    },
    "builder": {
      "kind": "github",
      "repository": "example/queue-worker",
      "allowedRefs": [
        "refs/heads/main"
      ],
      "workflowRef": "example/queue-worker/.github/workflows/liskov-release.yml@refs/heads/main",
      "manifestPath": ".liskov/application-manifest.json"
    }
  }
}
