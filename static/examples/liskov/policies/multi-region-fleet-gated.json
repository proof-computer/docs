{
  "schema": "proof.liskov.application-manifest",
  "schemaVersion": 4,
  "applicationId": "global-api",
  "metadata": {
    "appType": "managed-web-app",
    "labels": [
      "fleet",
      "multi-region",
      "advanced"
    ],
    "description": "A typed multi-region fleet policy that requires gated capabilities."
  },
  "runtime": {
    "engine": "nodejs",
    "command": "node server.js",
    "role": "global-api",
    "resources": {
      "memoryMiB": 1024,
      "storageMiB": 512,
      "networkRequestQuota": 10000
    },
    "requiredModules": [
      "network"
    ]
  },
  "deployment": {
    "parallelism": 4,
    "schedule": {
      "durationMs": 14400000,
      "maxStartDelayMs": 600000
    },
    "placement": {
      "requirements": {
        "trustProfile": "proof.liskov.attested-runtime.v1"
      },
      "groups": [
        {
          "name": "us",
          "count": 2,
          "geography": {
            "kind": "country",
            "standard": "ISO-3166-1-alpha-2",
            "values": [
              "US"
            ]
          }
        },
        {
          "name": "europe",
          "count": 2,
          "geography": {
            "kind": "region",
            "catalog": "proof.liskov.geo.v1",
            "values": [
              "eu-west",
              "eu-central"
            ]
          }
        }
      ],
      "topologyConstraints": [
        {
          "kind": "anti_affinity",
          "scope": "this_deployment",
          "topologyKey": "processor",
          "strength": "required"
        },
        {
          "kind": "anti_affinity",
          "scope": "this_deployment",
          "topologyKey": "operator",
          "strength": "preferred"
        }
      ],
      "processorSelection": {
        "mode": "open_market",
        "allowUnknownManager": false,
        "requireScheduleClear": true,
        "requireConsumerAccess": true,
        "maxHeartbeatAgeSeconds": 120,
        "candidateLimit": 64,
        "scanLimit": 256
      }
    },
    "lifecycle": {
      "renewal": {
        "mode": "before_scheduled_end",
        "leadTime": {
          "mode": "automatic",
          "profile": "proof.liskov.renewal-lead.v1"
        }
      },
      "update": {
        "timing": "immediate",
        "existingJobs": {
          "mode": "cooperative_cease",
          "trigger": "successor_runtime_ready"
        }
      },
      "recovery": {
        "launch": {
          "maxRetries": 5
        },
        "runtimeFailure": {
          "mode": "replace_after_failure",
          "contactLossAfterMs": 300000,
          "restartGraceMs": 600000,
          "maxSameJobRestarts": 3,
          "maxFreshRegistrationReplacements": 2
        }
      }
    },
    "spend": {
      "maxRewardPlanckPerJob": "100000000000",
      "maxNativeFeePlanckPerJob": "15000000000",
      "maxServiceCreditMicrosPerGeneration": 20000000
    }
  },
  "ingress": {
    "http": {
      "mode": "required",
      "port": 3000,
      "healthPath": "/health"
    }
  },
  "observability": {
    "logs": {
      "enabled": true,
      "profileId": "encrypted-json-v1",
      "sinkName": "primary"
    }
  },
  "release": {
    "mode": "build",
    "artifact": {
      "kind": "ipfs_bundle",
      "encryption": {
        "mode": "aes256_gcm"
      }
    },
    "builder": {
      "kind": "github",
      "repository": "example/global-api",
      "allowedRefs": [
        "refs/heads/main"
      ],
      "workflowRef": "example/global-api/.github/workflows/liskov-release.yml@refs/heads/main",
      "manifestPath": ".liskov/application-manifest.json"
    }
  }
}
