{
  "schema": "proof.liskov.application-manifest",
  "schemaVersion": 4,
  "applicationId": "partner-webhook",
  "metadata": {
    "appType": "managed-web-app",
    "labels": [
      "webhook",
      "partner-pool"
    ],
    "description": "A webhook receiver restricted to one processor manager."
  },
  "runtime": {
    "engine": "nodejs",
    "command": "node webhook.js",
    "role": "webhook",
    "resources": {
      "memoryMiB": 256,
      "storageMiB": 128,
      "networkRequestQuota": 2500
    },
    "requiredModules": [
      "network"
    ]
  },
  "deployment": {
    "parallelism": 1,
    "schedule": {
      "durationMs": 3600000,
      "maxStartDelayMs": 600000
    },
    "placement": {
      "processorSelection": {
        "mode": "manager",
        "managerId": "partner-manager",
        "allowUnknownManager": false,
        "requireScheduleClear": true,
        "requireConsumerAccess": true,
        "maxHeartbeatAgeSeconds": 300,
        "candidateLimit": 8,
        "scanLimit": 32
      }
    },
    "lifecycle": {
      "renewal": {
        "mode": "before_scheduled_end",
        "leadTime": {
          "mode": "fixed",
          "durationMs": 300000
        }
      },
      "update": {
        "timing": "immediate",
        "existingJobs": {
          "mode": "run_until_scheduled_end"
        }
      },
      "recovery": {
        "launch": {
          "maxRetries": 3
        },
        "runtimeFailure": {
          "mode": "wait_until_scheduled_end"
        }
      }
    }
  },
  "ingress": {
    "http": {
      "mode": "required",
      "port": 8080,
      "healthPath": "/ready"
    }
  },
  "release": {
    "mode": "build",
    "artifact": {
      "kind": "ipfs_bundle",
      "encryption": {
        "mode": "none"
      }
    },
    "builder": {
      "kind": "github",
      "repository": "example/partner-webhook",
      "allowedRefs": [
        "refs/heads/main"
      ],
      "workflowRef": "example/partner-webhook/.github/workflows/liskov-release.yml@refs/heads/main",
      "manifestPath": ".liskov/application-manifest.json"
    }
  }
}
