{
  "schema": "proof.liskov.application-policy",
  "schemaVersion": 4,
  "applicationId": "hardware-bound-indexer",
  "metadata": {
    "appType": "background-worker",
    "labels": [
      "indexer",
      "static-placement"
    ],
    "description": "A job pinned to an audited processor set."
  },
  "artifact": {
    "kind": "ipfs",
    "cid": "bafy-replace-with-your-cid",
    "encryption": {
      "mode": "aes256_gcm"
    }
  },
  "runtime": {
    "engine": "nodejs",
    "command": "node indexer.js",
    "role": "indexer",
    "resources": {
      "memoryMiB": 1024,
      "storageMiB": 2048,
      "networkRequestQuota": 10000
    },
    "requiredModules": [
      "network"
    ]
  },
  "deployment": {
    "parallelism": 1,
    "schedule": {
      "durationMs": 7200000,
      "startDelayMs": 60000,
      "maxStartDelayMs": 300000
    },
    "placement": {
      "requirements": {
        "trustProfile": "proof.liskov.attested-runtime.v1"
      },
      "processorSelection": {
        "mode": "static",
        "processorIds": [
          "5ProcessorAddressA",
          "5ProcessorAddressB"
        ],
        "managerId": "audited-manager",
        "allowUnknownManager": false,
        "requireScheduleClear": true,
        "requireConsumerAccess": true,
        "maxHeartbeatAgeSeconds": 120,
        "candidateLimit": 2,
        "scanLimit": 2
      }
    },
    "lifecycle": {
      "renewal": {
        "mode": "after_scheduled_end"
      },
      "update": {
        "timing": "next_scheduled_renewal",
        "existingJobs": {
          "mode": "run_until_scheduled_end"
        }
      },
      "recovery": {
        "launch": {
          "maxRetries": 1
        },
        "runtimeFailure": {
          "mode": "wait_until_scheduled_end"
        }
      }
    },
    "spend": {
      "maxRewardPlanckPerJob": "90000000000",
      "maxNativeFeePlanckPerJob": "10000000000"
    }
  },
  "configuration": {
    "secrets": [
      {
        "secretId": "indexer-token",
        "destination": {
          "kind": "env",
          "name": "INDEXER_TOKEN"
        }
      }
    ]
  }
}
