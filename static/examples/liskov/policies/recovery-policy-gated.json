{
  "schema": "proof.liskov.application-manifest",
  "schemaVersion": 4,
  "applicationId": "failure-sensitive-worker",
  "metadata": {
    "appType": "background-worker",
    "labels": [
      "recovery",
      "advanced"
    ],
    "description": "A single-slot worker using the typed replacement-after-failure contract."
  },
  "runtime": {
    "engine": "nodejs",
    "command": "node worker.js",
    "role": "worker",
    "resources": {
      "memoryMiB": 512,
      "storageMiB": 256,
      "networkRequestQuota": 1000
    }
  },
  "deployment": {
    "parallelism": 1,
    "schedule": {
      "durationMs": 7200000,
      "maxStartDelayMs": 300000
    },
    "lifecycle": {
      "renewal": {
        "mode": "after_scheduled_end"
      },
      "update": {
        "timing": "next_scheduled_renewal",
        "existingJobs": {
          "mode": "run_until_scheduled_end"
        }
      },
      "recovery": {
        "launch": {
          "maxRetries": 5
        },
        "runtimeFailure": {
          "mode": "replace_after_failure",
          "contactLossAfterMs": 300000,
          "restartGraceMs": 600000,
          "maxSameJobRestarts": 3,
          "maxFreshRegistrationReplacements": 2
        }
      }
    }
  },
  "release": {
    "mode": "build",
    "artifact": {
      "kind": "ipfs_bundle",
      "encryption": {
        "mode": "none"
      }
    },
    "builder": {
      "kind": "github",
      "repository": "example/failure-sensitive-worker",
      "allowedRefs": [
        "refs/heads/main"
      ],
      "workflowRef": "example/failure-sensitive-worker/.github/workflows/liskov-release.yml@refs/heads/main",
      "manifestPath": ".liskov/application-manifest.json"
    }
  }
}
