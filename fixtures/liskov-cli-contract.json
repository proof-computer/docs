{
  "package": "@proof-computer/proof-cli-liskov",
  "version": "0.6.0",
  "command": "liskov:application:logs",
  "arguments": ["APP_REF"],
  "flags": {
    "limit": { "minimum": 1, "maximum": 500 },
    "deployment": "string",
    "job": "string",
    "origin": ["all", "customer", "runtime-ssh"],
    "organization": {
      "environment": "LISKOV_ORGANIZATION",
      "maximumUtf8Bytes": 255,
      "resolution": "exact-id-before-exact-slug"
    },
    "json": "boolean"
  },
  "retiredCommands": [
    "liskov:application:blackbox",
    "liskov:application:blackbox:configure"
  ]
}
