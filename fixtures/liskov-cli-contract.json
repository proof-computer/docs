{
  "package": "@proof-computer/proof-cli-liskov",
  "version": "0.12.1",
  "command": "liskov:application:logs",
  "arguments": ["APP_REF"],
  "flags": {
    "limit": { "minimum": 1, "maximum": 500 },
    "deployment": "string",
    "job": "string",
    "origin": ["all", "customer", "runtime-ssh", "runtime_ssh"],
    "event": "string",
    "follow": "boolean",
    "from-start": "boolean",
    "ndjson": "boolean",
    "organization": {
      "environment": "LISKOV_ORGANIZATION",
      "maximumUtf8Bytes": 255,
      "resolution": "exact-id-before-exact-slug"
    },
    "json": "boolean"
  },
  "sshCommand": "liskov:ssh",
  "sshArguments": ["APP"],
  "sshFlags": {
    "identity": "string",
    "deployment": "string",
    "job": "string",
    "accept-host-key": "boolean",
    "print-command": "boolean",
    "json": "boolean"
  },
  "operatorKeyCommands": [
    "liskov:runtime-ssh:operator-key:add",
    "liskov:runtime-ssh:operator-key:list",
    "liskov:runtime-ssh:operator-key:remove"
  ],
  "operatorKeyAddFlags": {
    "name": "string",
    "identity": "string",
    "public-key-file": "string",
    "json": "boolean",
    "organization": "string"
  },
  "operatorKeyRemoveWithdrawsAccess": true,
  "withdrawnKeyCommands": [
    "liskov:runtime-ssh:withdrawn-key:add",
    "liskov:runtime-ssh:withdrawn-key:list",
    "liskov:runtime-ssh:withdrawn-key:remove"
  ],
  "withdrawnKeyAddFlags": {
    "fingerprint": "string",
    "identity": "string",
    "reason": "string",
    "json": "boolean",
    "organization": "string"
  },
  "withdrawalDrain": {
    "establishedSessions": "drain",
    "maximumSessionDurationSeconds": 7200,
    "heartbeatTimeoutSeconds": 60
  },
  "attachmentCommands": [
    "liskov:runtime-ssh:attachment:list",
    "liskov:runtime-ssh:attachment:revoke"
  ],
  "attachmentListFlags": {
    "include-terminal": "boolean",
    "json": "boolean",
    "organization": "string"
  },
  "attachmentRevokeFailureCode": "operator_revoked",
  "attachmentRevokeEndsTheJob": false,
  "retiredCommands": [
    "liskov:application:blackbox",
    "liskov:application:blackbox:configure"
  ]
}
